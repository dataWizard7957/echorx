-- EchoRx: register the synthetic care data in Zetaris.
-- Generated into zetaris/register.sql by `npm run zetaris:sql` (fills in {{DATA_BASE_URL}}).
-- Run with `npm run zetaris:register`, or paste ONE statement at a time into the Zetaris SQL Editor.
-- Pattern: same as Zetaris getting-started recipe 02_pokeapi_create.sql
-- (REST table over a JSON object with a `data` array, flattened by a SchemaStore view).

CREATE LIGHTNING DATABASE ECHORX_REST DESCRIBE BY "EchoRx synthetic care data REST source";

CREATE SCHEMASTORE CONTAINER echorx;

CREATE LIGHTNING REST TABLE patients_raw FROM ECHORX_REST REQUEST(
    endpoint "{{DATA_BASE_URL}}/patients.json",
    method "get",
    response_type "json",
    http_encoding "URLENCODED"
) HEADER (
) BODY ();

CREATE SCHEMASTORE VIEW patients WITH CONTAINER echorx AS
SELECT r.patient_id AS patient_id, r.display_name AS display_name, r.age AS age, r.zip AS zip, r.language AS language, r.has_car AS has_car, r.mobility AS mobility, r.neighborhood AS neighborhood, r.home_lat AS home_lat, r.home_lng AS home_lng
FROM echorx_rest.patients_raw LATERAL VIEW explode(data) AS r;

CREATE LIGHTNING REST TABLE pharmacy_fills_raw FROM ECHORX_REST REQUEST(
    endpoint "{{DATA_BASE_URL}}/pharmacy_fills.json",
    method "get",
    response_type "json",
    http_encoding "URLENCODED"
) HEADER (
) BODY ();

CREATE SCHEMASTORE VIEW pharmacy_fills WITH CONTAINER echorx AS
SELECT r.fill_id AS fill_id, r.patient_id AS patient_id, r.drug AS drug, r.strength AS strength, r.directions AS directions, r.fill_date AS fill_date, r.days_supply AS days_supply, r.pharmacy AS pharmacy
FROM echorx_rest.pharmacy_fills_raw LATERAL VIEW explode(data) AS r;

CREATE LIGHTNING REST TABLE visit_history_raw FROM ECHORX_REST REQUEST(
    endpoint "{{DATA_BASE_URL}}/visit_history.json",
    method "get",
    response_type "json",
    http_encoding "URLENCODED"
) HEADER (
) BODY ();

CREATE SCHEMASTORE VIEW visit_history WITH CONTAINER echorx AS
SELECT r.visit_id AS visit_id, r.patient_id AS patient_id, r.visit_date AS visit_date, r.site AS site, r.reason AS reason, r.med_changes AS med_changes
FROM echorx_rest.visit_history_raw LATERAL VIEW explode(data) AS r;

