# Copy to .env and fill in real values. Never commit .env.
# With no .env at all, EchoRx starts in SAMPLE_MODE (no credentials needed).

# --- Mode ---
SAMPLE_MODE=false            # true = no Zetaris, no Nightshift; scripted agent responses + data/*.json

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_SCHEMA=echorx
# Where the Zetaris SERVER can download data/*.json (it can't read files on your laptop):
DATA_BASE_URL=https://raw.githubusercontent.com/<your-github-user>/echorx/main/data

# --- POWER: Meterless Nightshift (copy from Nightshift > Console, top right) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=echorx

# --- Model lanes: pin Nemotron so the trace proves which model answered ---
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b
MODEL_VISION=meterless/vision
MODEL_FALLBACK=meterless/auto

# --- App ---
PORT=8787
HMEM_DIR=./var/hmem

# NOTE: your NVIDIA API key does NOT go here. It goes in Nightshift > Setup > Providers.
